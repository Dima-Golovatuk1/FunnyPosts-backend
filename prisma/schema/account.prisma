model Account {
  id           String   @id @default(uuid())
  provider     Provider
  providerId   String
  type         String
  accessToken  String?
  refreshToken String?
  expiresAt    Int
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

enum AccountType {
  OAUTH
}

enum Provider {
  GOOGLE
}
